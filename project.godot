; Engine configuration file.
; ERA: Ascension — Godot 4.7

config_version=5

[application]

config/name="ERA: Восхождение"
config/description="3D Action RPG: пять исторических эпох, живой мир, живые легенды."
config/version="0.11.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://assets/icon/icon.png"
boot_splash/bg_color=Color(0.04, 0.035, 0.06, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icon/splash.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
run/low_processor_mode=false

[autoload]

Events="*res://scripts/core/events.gd"
Settings="*res://scripts/core/settings.gd"
Chronicle="*res://scripts/history/chronicle.gd"
Profile="*res://scripts/core/profile.gd"
SaveSys="*res://scripts/save/save_system.gd"
Audio="*res://scripts/audio/audio_manager.gd"
Game="*res://scripts/core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

theme/custom_font="res://assets/fonts/PT_Sans-Web-Regular.ttf"
common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=30
common/max_physics_steps_per_frame=4
common/physics_interpolation=true
3d/default_gravity=24.0

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
lights_and_shadows/positional_shadow/atlas_size.mobile=1024

[shader_globals]

weather_wet={
"type": "float",
"value": 0.0
}
weather_snow={
"type": "float",
"value": 0.0
}
