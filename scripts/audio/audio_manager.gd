extends Node
## Audio autoload ("Audio"): pooled 2D/3D sound effects, crossfaded music,
## one-shot stings with music ducking and looping ambient beds.
## All assets are procedurally generated by tools/gen_audio.py.

const SFX_PATH := "res://assets/audio/sfx/%s.wav"
const MUSIC_PATH := "res://assets/audio/music/%s.ogg"
const POOL_2D := 12
const POOL_3D := 16
const THROTTLE_MS := 40
const DUCK_DB := -10.0
const SILENT_DB := -60.0

const BUS_SFX := "SFX"
const BUS_MUSIC := "Music"
const BUS_BED := "MusicBed"

var current_track: String = ""

var _cache: Dictionary = {}
var _warned: Dictionary = {}
var _last_play: Dictionary = {}
var _pool2d: Array[AudioStreamPlayer] = []
var _pool3d: Array[AudioStreamPlayer3D] = []
var _rr2d := 0
var _rr3d := 0
var _music_a: AudioStreamPlayer
var _music_b: AudioStreamPlayer
var _music_active: AudioStreamPlayer
var _music_tween: Tween
var _sting: AudioStreamPlayer
var _duck_tween: Tween
var _ambient: Dictionary = {}
var _amb_tweens: Dictionary = {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_ensure_bus(BUS_SFX, "Master")
	_ensure_bus(BUS_MUSIC, "Master")
	_ensure_bus(BUS_BED, BUS_MUSIC)
	for i in POOL_2D:
		var p := AudioStreamPlayer.new()
		p.bus = BUS_SFX
		add_child(p)
		_pool2d.append(p)
	for i in POOL_3D:
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = BUS_SFX
		p3.unit_size = 12.0
		p3.max_distance = 60.0
		p3.attenuation_model = AudioStreamPlayer3D.ATTENUATION_INVERSE_DISTANCE
		p3.doppler_tracking = AudioStreamPlayer3D.DOPPLER_TRACKING_DISABLED
		add_child(p3)
		_pool3d.append(p3)
	_music_a = _make_player(BUS_BED)
	_music_b = _make_player(BUS_BED)
	_music_active = _music_a
	_sting = _make_player(BUS_MUSIC)
	_sting.finished.connect(_on_sting_finished)
	apply_volumes()


func _make_player(bus_name: String) -> AudioStreamPlayer:
	var p := AudioStreamPlayer.new()
	p.bus = bus_name
	p.volume_db = SILENT_DB
	add_child(p)
	return p


func _ensure_bus(bus_name: String, send_to: String) -> void:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		AudioServer.add_bus(AudioServer.bus_count)
		idx = AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
	AudioServer.set_bus_send(idx, send_to)


func _warn_once(key: String, msg: String) -> void:
	if not _warned.has(key):
		_warned[key] = true
		push_warning(msg)


func _load(path: String) -> AudioStream:
	if _cache.has(path):
		return _cache[path]
	var s: AudioStream = null
	if ResourceLoader.exists(path):
		s = load(path) as AudioStream
	_cache[path] = s
	if s == null:
		_warn_once(path, "Audio: missing stream " + path)
	return s


func _get_sfx(sfx_name: String) -> AudioStream:
	return _load(SFX_PATH % sfx_name)


# ---------------------------------------------------------------- SFX
func play_sfx(sfx_name: String, pos = null, vol_db := 0.0, pitch_var := 0.08) -> void:
	if sfx_name.is_empty():
		return
	var now := Time.get_ticks_msec()
	if _last_play.has(sfx_name) and now - int(_last_play[sfx_name]) < THROTTLE_MS:
		return
	var stream := _get_sfx(sfx_name)
	if stream == null:
		return
	_last_play[sfx_name] = now
	var pitch := 1.0 + randf_range(-pitch_var, pitch_var) if pitch_var > 0.0 else 1.0
	if pos is Vector3:
		var p3 := _free_3d()
		p3.stream = stream
		p3.volume_db = vol_db
		p3.pitch_scale = maxf(0.05, pitch)
		p3.global_position = pos
		p3.play()
	else:
		var p := _free_2d()
		p.stream = stream
		p.volume_db = vol_db
		p.pitch_scale = maxf(0.05, pitch)
		p.play()


func _free_2d() -> AudioStreamPlayer:
	for p in _pool2d:
		if not p.playing:
			return p
	_rr2d = (_rr2d + 1) % _pool2d.size()
	return _pool2d[_rr2d]


func _free_3d() -> AudioStreamPlayer3D:
	for p in _pool3d:
		if not p.playing:
			return p
	_rr3d = (_rr3d + 1) % _pool3d.size()
	return _pool3d[_rr3d]


func ui_click() -> void:
	play_sfx("ui_click", null, -4.0, 0.03)


# ---------------------------------------------------------------- Music
func play_music(track: String, fade := 1.5) -> void:
	if track == current_track and _music_active != null and _music_active.playing:
		return
	var stream := _load(MUSIC_PATH % track)
	if stream == null:
		return
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = true
	current_track = track
	var old := _music_active
	var nxt := _music_b if _music_active == _music_a else _music_a
	if _music_tween != null and _music_tween.is_valid():
		_music_tween.kill()
	nxt.stream = stream
	nxt.volume_db = SILENT_DB
	nxt.play()
	_music_active = nxt
	var f := maxf(0.01, fade)
	_music_tween = create_tween().set_parallel(true)
	_music_tween.tween_property(nxt, "volume_db", 0.0, f).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	if old != null and old.playing:
		_music_tween.tween_property(old, "volume_db", SILENT_DB, f).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_IN)
		_music_tween.chain().tween_callback(old.stop)


func stop_music(fade := 1.5) -> void:
	current_track = ""
	if _music_tween != null and _music_tween.is_valid():
		_music_tween.kill()
	_music_tween = create_tween().set_parallel(true)
	for p in [_music_a, _music_b]:
		if p.playing:
			_music_tween.tween_property(p, "volume_db", SILENT_DB, maxf(0.01, fade))
	_music_tween.chain().tween_callback(_stop_music_players)


func _stop_music_players() -> void:
	_music_a.stop()
	_music_b.stop()


func play_sting(sting_name: String) -> void:
	var stream := _load(MUSIC_PATH % sting_name)
	if stream == null:
		return
	if stream is AudioStreamOggVorbis:
		(stream as AudioStreamOggVorbis).loop = false
	_sting.stream = stream
	_sting.volume_db = 0.0
	_sting.play()
	_duck(true)


func _on_sting_finished() -> void:
	_duck(false)


func _duck(on: bool) -> void:
	var idx := AudioServer.get_bus_index(BUS_BED)
	if idx == -1:
		return
	if _duck_tween != null and _duck_tween.is_valid():
		_duck_tween.kill()
	var from := AudioServer.get_bus_volume_db(idx)
	var to := DUCK_DB if on else 0.0
	_duck_tween = create_tween()
	_duck_tween.tween_method(_set_bed_db, from, to, 0.35 if on else 1.2)


func _set_bed_db(db: float) -> void:
	var idx := AudioServer.get_bus_index(BUS_BED)
	if idx != -1:
		AudioServer.set_bus_volume_db(idx, db)


# ---------------------------------------------------------------- Ambient
func set_ambient(amb_name: String, on: bool, fade := 2.0) -> void:
	var p: AudioStreamPlayer = _ambient.get(amb_name)
	if on:
		if p == null:
			var stream := _get_sfx(amb_name)
			if stream == null:
				return
			if stream is AudioStreamWAV:
				var w := stream as AudioStreamWAV
				w.loop_mode = AudioStreamWAV.LOOP_FORWARD
				w.loop_begin = 0
				w.loop_end = int(round(w.get_length() * float(w.mix_rate)))
			p = AudioStreamPlayer.new()
			p.bus = BUS_SFX
			p.stream = stream
			p.volume_db = SILENT_DB
			add_child(p)
			_ambient[amb_name] = p
		if not p.playing:
			p.volume_db = SILENT_DB
			p.play()
		_tween_ambient(amb_name, p, -6.0, fade, false)
	elif p != null and p.playing:
		_tween_ambient(amb_name, p, SILENT_DB, fade, true)


func _tween_ambient(amb_name: String, p: AudioStreamPlayer, to_db: float, fade: float, stop_after: bool) -> void:
	var old: Tween = _amb_tweens.get(amb_name)
	if old != null and old.is_valid():
		old.kill()
	var tw := create_tween()
	tw.tween_property(p, "volume_db", to_db, maxf(0.01, fade))
	if stop_after:
		tw.tween_callback(p.stop)
	_amb_tweens[amb_name] = tw


func stop_all_ambient(fade := 1.0) -> void:
	for k in _ambient.keys():
		set_ambient(k, false, fade)


# ---------------------------------------------------------------- Volumes
func apply_volumes() -> void:
	var music_vol := 0.8
	var sfx_vol := 0.9
	var s := get_node_or_null("/root/Settings")
	if s != null:
		var mv = s.get("music_vol")
		var sv = s.get("sfx_vol")
		if mv != null:
			music_vol = float(mv)
		if sv != null:
			sfx_vol = float(sv)
	_set_bus_linear(BUS_MUSIC, music_vol)
	_set_bus_linear(BUS_SFX, sfx_vol)


func _set_bus_linear(bus_name: String, v: float) -> void:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		return
	v = clampf(v, 0.0, 1.0)
	AudioServer.set_bus_mute(idx, v <= 0.001)
	AudioServer.set_bus_volume_db(idx, linear_to_db(maxf(v, 0.001)))
