extends Node
## Global event bus. Subsystems communicate through these signals instead of
## holding direct references to each other.

signal actor_damaged(target, amount: float, source, dtype: String)
signal actor_killed(victim, killer)
signal actor_spawned(actor)
signal xp_gained(actor, amount: int)
signal level_up(actor, lvl: int)
signal mastery_up(actor, cat: String, lvl: int)
signal item_picked(actor, item: Dictionary)
signal item_equipped(actor, item: Dictionary)
signal chest_opened(actor, chest)
signal chronicle(ev: Dictionary)
signal notify(text: String, color: Color)
signal banner(title: String, subtitle: String, color: Color)
signal quest_updated(quest: Dictionary)
signal quest_completed(quest: Dictionary)
signal faction_rep_changed(fid: String, value: float)
signal world_event_started(ev: Dictionary)
signal world_event_ended(ev: Dictionary)
signal boss_phase(boss, phase: int)
signal boss_engaged(boss)
signal boss_defeated(boss)
signal interact_changed(target)
signal ui_opened(ui_name: String)
signal ui_closed(ui_name: String)
signal era_changed(era: int)
signal point_captured(cp, owner: String)
signal settlement_changed(settlement: Dictionary)
signal resonance(info: Dictionary)
signal legend_born(record: Dictionary)
signal legend_died(record: Dictionary)
signal achievement(id: String)
signal player_died()
signal player_respawned()
signal dimension_entered(kind: String)
signal dimension_left(kind: String)
signal settings_changed()
signal input_reset()
