static func era(i: int) -> Dictionary:
	return ERAS[clampi(i, 0, ERA_COUNT - 1)]

static func faction(fid: String) -> Dictionary:
	return FACTIONS.get(fid, {})

static func factions_of(era_i: int) -> Array:
	return ERAS[era_i].factions

static func rank_for_rep(rep: float) -> int:
	var r := 0
	for i in RANK_REP.size():
		if rep >= RANK_REP[i]:
			r = i
	return r

static func predecessor(fid: String) -> String:
	for k in FACTIONS:
		if FACTIONS[k].successor == fid:
			return k
	return ""
