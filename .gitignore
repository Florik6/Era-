# Godot
.godot/
*.tmp
# Build outputs: only the final deliverables in builds/android and builds/ios
# are tracked; intermediate exports stay local.
builds/*
!builds/android/
!builds/ios/
builds/**/*.idsig
# iOS Xcode export: the official Godot engine frameworks (hundreds of MB,
# taken unchanged from the Godot iOS template) are regenerated by
# tools/export_ios.sh and by the CI workflow; the project itself is tracked.
exports/ios_xcode/*.xcframework/
exports/ios_xcode/build/
export_credentials.cfg
# Signing keys are generated locally by tools/build_apk.sh
android/*.keystore
*.jks
android/release_pass.txt
# Claude Code personal settings
.claude/settings.local.json
